# serves - the WebP tiers under narratedbynb-site/assets/frames/ - IS tracked.
/frames_v7/
/frames_v7_shadow/

# Full-resolution stills pulled out of the hero clip by extract_hero.py.
# 245 PNGs at 1080x1920, about 470MB, and regenerable from the clip in a
# couple of minutes. The WebP tiers the site serves, under
# narratedbynb-site/assets/hero/, ARE tracked.
/frames_hero/

# pulled in locally for the sharp-based texture/frame scripts
/node_modules/
/package-lock.json

